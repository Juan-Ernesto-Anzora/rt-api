        {"name": "JWT Verify", "request": {"auth": {"type": "noauth"}, "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"token\":\"{{TOKEN}}\"}"}, "url": "{{base_url}}/api/auth/jwt/verify"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Token verifies', () => pm.response.to.have.status(200));"]}}]},
        {"name": "Missing Tenant", "request": {"method": "GET", "url": "{{base_url}}/api/requests/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Missing tenant 400', () => pm.response.to.have.status(400));"]}}]},
        {"name": "Missing JWT", "request": {"auth": {"type": "noauth"}, "method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/requests/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Missing JWT 401', () => pm.response.to.have.status(401));"]}}]}
      ]
    },
    {
      "name": "02 Admin Permission Context",
