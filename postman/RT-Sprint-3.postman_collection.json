        {"name": "Effective Permissions", "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/admin/me/permissions/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Permissions 200', () => pm.response.to.have.status(200));", "const r=pm.response.json(); pm.expect(r.permissions).to.include('admin.read'); pm.expect(r.permissions).to.include('admin.workflows'); pm.environment.set('actor_id',r.user.user_id);"]}}]}
