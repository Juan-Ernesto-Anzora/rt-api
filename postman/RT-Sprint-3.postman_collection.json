      "listen": "test",
      "script": {"type": "text/javascript", "exec": [
        "pm.test('No server error', () => pm.expect(pm.response.code).to.be.below(500));",
        "const ct = pm.response.headers.get('Content-Type') || '';",
        "if (pm.response.code >= 400 && ct.includes('json')) { const e = pm.response.json(); pm.test('Canonical error envelope', () => { pm.expect(e).to.have.all.keys('code','message','details'); pm.expect(e.details).to.be.an('array'); }); }",
        "pm.test('No technical disclosure', () => pm.expect(pm.response.text()).not.to.match(/Traceback|IntegrityError|FieldError|ProgrammingError|SQLExecDirect|<html/i));"
      ]}
    }
  ],
  "item": [
    {
      "name": "01 Authentication and Tenant",
      "item": [
        {"name": "Health", "request": {"auth": {"type": "noauth"}, "method": "GET", "url": "{{base_url}}/api/health"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Health 200', () => pm.response.to.have.status(200));"]}}]},
