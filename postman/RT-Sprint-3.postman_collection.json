    },
    {
      "name": "10 Tenant Settings",
      "item": [
        {"name": "Get Settings", "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/admin/settings/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Settings 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().settings).to.have.length(4);"]}}]},
        {"name": "No-op Settings Patch", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true') pm.execution.skipRequest();"]}}], "request": {"method": "PATCH", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"settings\":[{\"key\":\"default_page_size\",\"value\":\"20\",\"value_type\":\"integer\"}]}"}, "url": "{{base_url}}/api/admin/settings/"}}
      ]
    },
    {
      "name": "11 Feature Flags",
      "item": [
        {"name": "List Flags", "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/admin/feature-flags/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Flags 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().map(x=>x.key)).to.include('notificationTemplates');"]}}]},
        {"name": "Patch Flag", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true') pm.execution.skipRequest();"]}}], "request": {"method": "PATCH", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"enabled\":true}"}, "url": "{{base_url}}/api/admin/feature-flags/{{feature_flag_key}}/"}}
      ]
    },
    {
      "name": "12 Notification Templates",
      "item": [
        {"name": "List Templates", "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/admin/notification-templates/"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Templates 200', () => pm.response.to.have.status(200));", "const r=pm.response.json(); pm.expect(r).to.have.length(4); if(r.length){pm.environment.set('notification_template_id',r[0].notification_template_id);}"]}}]},
        {"name": "Template Detail", "event": [{"listen": "prerequest", "script": {"exec": ["if (!pm.environment.get('notification_template_id')) pm.execution.skipRequest();"]}}], "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/admin/notification-templates/{{notification_template_id}}/"}},
        {"name": "Patch Template", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true' || !pm.environment.get('notification_template_id')) pm.execution.skipRequest();"]}}], "request": {"method": "PATCH", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"subject_template\":\"Day10 {human_id}\",\"body_template\":\"Request {request_id}: {title}\\nLink: {request_url}\",\"is_active\":true}"}, "url": "{{base_url}}/api/admin/notification-templates/{{notification_template_id}}/"}}
      ]
    },
    {
      "name": "13 Sprint 2 Request Lifecycle",
      "item": [
        {"name": "Flow Lookups", "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/flows/?page=1&page_size=25"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Flows 200', () => pm.response.to.have.status(200));", "const r=pm.response.json(); const flow=r.results.find(x=>x.name==='IT Support') || r.results.find(x=>!x.name.startsWith('Day10')); if(flow){pm.environment.set('flow_id',flow.flow_id);}"]}}]},
        {"name": "Status Lookups", "event": [{"listen": "prerequest", "script": {"exec": ["if (!pm.environment.get('flow_id')) pm.execution.skipRequest();"]}}, {"listen": "test", "script": {"exec": ["pm.test('Statuses 200', () => pm.response.to.have.status(200));", "const r=pm.response.json(); const open=r.find(x=>x.category==='open'); if(open){pm.environment.set('status_id',open.status_id);}"]}}], "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/flows/{{flow_id}}/statuses/"}},
        {"name": "User Lookups", "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/users/?page=1&page_size=25"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Lookup users 200', () => pm.response.to.have.status(200));", "const r=pm.response.json(); if(r.results.length){pm.environment.set('requester_id',r.results[0].user_id); pm.environment.set('assignee_id',r.results[0].user_id);}"]}}]},
        {"name": "Request List", "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/requests/?page=1&page_size=10"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Requests 200', () => pm.response.to.have.status(200));", "const r=pm.response.json(); if(r.results.length){pm.environment.set('request_id',r.results[0].request_id);}"]}}]},
        {"name": "Request Detail", "event": [{"listen": "prerequest", "script": {"exec": ["if (!pm.environment.get('request_id')) pm.execution.skipRequest();"]}}], "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/requests/{{request_id}}/"}},
        {"name": "Create Request", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true' || !pm.environment.get('flow_id') || !pm.environment.get('status_id') || !pm.environment.get('requester_id')) pm.execution.skipRequest();"]}}, {"listen": "test", "script": {"exec": ["if(pm.response.code===201) pm.environment.set('request_id',pm.response.json().request_id);"]}}], "request": {"method": "POST", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"title\":\"Day10 {{created_suffix}}\",\"description\":\"Postman lifecycle verification\",\"priority\":\"normal\",\"flow_id\":\"{{flow_id}}\",\"status_id\":\"{{status_id}}\",\"requester_id\":\"{{requester_id}}\",\"assignee_id\":\"{{assignee_id}}\"}"}, "url": "{{base_url}}/api/requests/"}}
      ]
    },
    {
      "name": "14 Search Attachments Comments Transitions Notifications",
      "item": [
        {"name": "Search Requests", "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/search/requests?q=vpn&page=1&page_size=10"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('Search 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.have.all.keys('count','page','page_size','results');"]}}]},
        {"name": "List Comments", "event": [{"listen": "prerequest", "script": {"exec": ["if (!pm.environment.get('request_id')) pm.execution.skipRequest();"]}}], "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/requests/{{request_id}}/comments/"}},
        {"name": "Add Comment", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true' || !pm.environment.get('request_id')) pm.execution.skipRequest();"]}}], "request": {"method": "POST", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"body\":\"Day10 {{created_suffix}}\"}"}, "url": "{{base_url}}/api/requests/{{request_id}}/comments/"}},
        {"name": "List Attachments", "event": [{"listen": "prerequest", "script": {"exec": ["if (!pm.environment.get('request_id')) pm.execution.skipRequest();"]}}], "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/requests/{{request_id}}/attachments/"}},
        {"name": "Initialize Attachment", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true' || !pm.environment.get('request_id')) pm.execution.skipRequest();"]}}, {"listen": "test", "script": {"exec": ["pm.test('Attachment init 200', () => pm.response.to.have.status(200));", "const r=pm.response.json(); pm.environment.set('upload_group_id',r.group_id); pm.environment.set('upload_put_url',r.uploads[0].url); pm.environment.set('upload_object_key',r.uploads[0].object_key);"]}}], "request": {"method": "POST", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"request_id\":\"{{request_id}}\",\"files\":[{\"filename\":\"day10-{{created_suffix}}.txt\",\"content_type\":\"text/plain\",\"size_bytes\":20}]}"}, "url": "{{base_url}}/api/attachments/init"}},
        {"name": "PUT Attachment to MinIO", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true' || !pm.environment.get('upload_put_url')) pm.execution.skipRequest();"]}}, {"listen": "test", "script": {"exec": ["pm.test('MinIO PUT succeeds', () => pm.expect(pm.response.code).to.be.oneOf([200,204]));"]}}], "request": {"auth": {"type": "noauth"}, "method": "PUT", "header": [{"key": "Content-Type", "value": "text/plain"}], "body": {"mode": "raw", "raw": "Day10 attachment smoke"}, "url": "{{upload_put_url}}"}},
        {"name": "Finalize Attachment", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true' || !pm.environment.get('upload_object_key')) pm.execution.skipRequest();"]}}, {"listen": "test", "script": {"exec": ["pm.test('Attachment finalize 201', () => pm.response.to.have.status(201));", "pm.expect(pm.response.json().attachments).to.have.length(1);"]}}], "request": {"method": "POST", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"request_id\":\"{{request_id}}\",\"group_id\":\"{{upload_group_id}}\",\"message\":\"Day10 grouped upload\",\"files\":[{\"object_key\":\"{{upload_object_key}}\",\"filename\":\"day10-{{created_suffix}}.txt\",\"content_type\":\"text/plain\",\"size_bytes\":20}]}"}, "url": "{{base_url}}/api/attachments/finalize"}},
        {"name": "Available Transitions", "event": [{"listen": "prerequest", "script": {"exec": ["if (!pm.environment.get('request_id')) pm.execution.skipRequest();"]}}, {"listen": "test", "script": {"exec": ["if(pm.response.code===200){const r=pm.response.json(); if(r.length){pm.environment.set('transition_id',r[0].transition_id);}}"]}}], "request": {"method": "GET", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}], "url": "{{base_url}}/api/requests/{{request_id}}/available-transitions/"}},
        {"name": "Transition Request", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true' || !pm.environment.get('transition_id')) pm.execution.skipRequest();"]}}, {"listen": "test", "script": {"exec": ["pm.test('Transition succeeds', () => pm.response.to.have.status(200));"]}}], "request": {"method": "POST", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"transition_id\":\"{{transition_id}}\",\"comment\":\"Day10 transition\"}"}, "url": "{{base_url}}/api/requests/{{request_id}}/transition/"}},
        {"name": "Close Request", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true' || !pm.environment.get('request_id')) pm.execution.skipRequest();"]}}, {"listen": "test", "script": {"exec": ["pm.test('Close succeeds', () => pm.response.to.have.status(200));"]}}], "request": {"method": "POST", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"comment\":\"Day10 close\"}"}, "url": "{{base_url}}/api/requests/{{request_id}}/close/"}},
        {"name": "Reopen Request", "event": [{"listen": "prerequest", "script": {"exec": ["if (pm.environment.get('allow_mutation') !== 'true' || !pm.environment.get('request_id')) pm.execution.skipRequest();"]}}, {"listen": "test", "script": {"exec": ["pm.test('Reopen succeeds', () => pm.response.to.have.status(200));"]}}], "request": {"method": "POST", "header": [{"key": "X-Tenant", "value": "{{tenant_code}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"comment\":\"Day10 reopen\"}"}, "url": "{{base_url}}/api/requests/{{request_id}}/reopen/"}}
      ]
    }
  ]
}
